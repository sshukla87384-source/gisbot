# syntax=docker/dockerfile:1.7
# Parameterized image for all Node apps (api / telegram-bot / worker / migrate).
# Build from repo root:  docker build -f infrastructure/docker/Dockerfile.node --build-arg APP=@gis/api .
# pnpm is installed directly via npm (NOT corepack) at a pinned version, so the
# build never depends on corepack downloading/verifying a newer pnpm release —
# that was the silent build failure. --no-frozen-lockfile tolerates drift.

ARG NODE_VERSION=22
ARG PNPM_VERSION=9.15.0

FROM node:${NODE_VERSION}-alpine AS deps
ARG APP
ARG PNPM_VERSION
# Alpine's CDN can fail TLS on some hosts, which empties the package index and
# makes every package look missing. Retry, fall back to the http mirror, and
# never fail the build for openssl — node:22-alpine already ships libssl3,
# which is what Prisma actually links against.
RUN set -eux; \
    for i in 1 2 3; do apk update && break || sleep 5; done || \
      (echo "https://dl-cdn.alpinelinux.org/alpine/v3.21/main" > /etc/apk/repositories && \
       echo "https://dl-cdn.alpinelinux.org/alpine/v3.21/community" >> /etc/apk/repositories && \
       apk update) || true; \
    (apk add --no-cache openssl || true); \
    npm install -g pnpm@${PNPM_VERSION}
WORKDIR /app
COPY . .
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @gis/database exec prisma generate

FROM node:${NODE_VERSION}-alpine AS runner
ARG APP
ARG PNPM_VERSION
# Alpine's CDN can fail TLS on some hosts, which empties the package index and
# makes every package look missing. Retry, fall back to the http mirror, and
# never fail the build for openssl — node:22-alpine already ships libssl3,
# which is what Prisma actually links against.
RUN set -eux; \
    for i in 1 2 3; do apk update && break || sleep 5; done || \
      (echo "https://dl-cdn.alpinelinux.org/alpine/v3.21/main" > /etc/apk/repositories && \
       echo "https://dl-cdn.alpinelinux.org/alpine/v3.21/community" >> /etc/apk/repositories && \
       apk update) || true; \
    (apk add --no-cache openssl curl || apk add --no-cache curl || true); \
    npm install -g pnpm@${PNPM_VERSION}
ENV NODE_ENV=production
ENV APP_FILTER=${APP}
WORKDIR /app
COPY --from=deps --chown=node:node /app /app
USER node
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT:-8080}/health" || exit 1
CMD ["sh", "-c", "exec pnpm --filter \"$APP_FILTER\" start"]
