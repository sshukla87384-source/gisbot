# syntax=docker/dockerfile:1.7
# Admin panel (@gis/admin-panel — Next.js 14, output: "standalone").
# pnpm installed via npm (pinned) — no corepack/frozen-lockfile fragility.
ARG NODE_VERSION=22
ARG PNPM_VERSION=9.15.0

FROM node:${NODE_VERSION}-alpine AS build
ARG NEXT_PUBLIC_API_URL
ARG PNPM_VERSION
# Alpine's CDN can fail TLS on some hosts, which empties the package index and
# makes every package look missing. Retry, fall back to the http mirror, and
# never fail the build for openssl — node:22-alpine already ships libssl3,
# which is what Prisma actually links against.
RUN set -eux; \
    for i in 1 2 3; do apk update && break || sleep 5; done || \
      (echo "https://dl-cdn.alpinelinux.org/alpine/v3.21/main" > /etc/apk/repositories && \
       echo "https://dl-cdn.alpinelinux.org/alpine/v3.21/community" >> /etc/apk/repositories && \
       apk update) || true; \
    for i in 1 2 3; do apk add --no-cache openssl libssl3 && break || sleep 5; done || true; \
    npm install -g pnpm@${PNPM_VERSION}
WORKDIR /app
COPY . .
RUN pnpm install --no-frozen-lockfile
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN pnpm --filter @gis/admin-panel build

FROM node:${NODE_VERSION}-alpine AS runner
RUN for i in 1 2 3; do apk add --no-cache curl && break || sleep 5; done || true
ENV PRISMA_CLI_BINARY_TARGETS=linux-musl-openssl-3.0.x
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/admin-panel/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/admin-panel/.next/static ./apps/admin-panel/.next/static
COPY --from=build --chown=node:node /app/apps/admin-panel/public ./apps/admin-panel/public
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:3000/login" || exit 1
CMD ["node", "apps/admin-panel/server.js"]
